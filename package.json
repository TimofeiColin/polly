{
  "name": "polly",
  "version": "0.0.1",
  "description": "Telegram bot that creates game night polls through a button menu, with moods, saved chats, locations and times.",
  "author": "Colin Timofei",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimofeiColin/polly.git"
  },
  "homepage": "https://github.com/TimofeiColin/polly#readme",
  "bugs": {
    "url": "https://github.com/TimofeiColin/polly/issues"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "polls",
    "nestjs",
    "grammy",
    "typescript"
  ],
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "pm2:start": "pm2 startOrRestart ecosystem.config.js",
    "pm2:deploy": "npm run build && npm run pm2:start",
    "pm2:list": "pm2 ls",
    "pm2:stop": "pm2 stop polly"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.1",
    "grammy": "^1.46.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
